smoking_data$l_cancer_male    <- log(smoking_data$cancer_male)
par(mfrow = c(1, 3))
plot(smoking_data$l_excise_tax, smoking_data$l_smoking_total, main = "Log Excise Tax vs Log Smoking Total", xlab = "Log Excise Tax", ylab = "Log Smoking Total")
abline(lm(l_smoking_total ~ l_excise_tax, data = smoking_data), col = "red")
plot(smoking_data$l_excise_tax, smoking_data$l_smoking_male, main = "Log Excise Tax vs Log Smoking Male", xlab = "Log Excise Tax", ylab = "Log Smoking Male")
abline(lm(l_smoking_male ~ l_excise_tax, data = smoking_data), col = "red")
plot(smoking_data$l_excise_tax, smoking_data$l_smoking_female, main = "Log Excise Tax vs Log Smoking Female", xlab = "Log Excise Tax", ylab = "Log Smoking Female")
abline(lm(l_smoking_female ~ l_excise_tax, data = smoking_data), col = "red")
par(mfrow = c(1, 1))
smoking_data$period <- ifelse(smoking_data$year <= 2010, "Early", "Late")
plot(smoking_data$excise_tax, smoking_data$smoking_total,
col = ifelse(smoking_data$period == "Early", "blue", "red"),
pch = 16, main = "Excise Tax vs Smoking Total by Period",
xlab = "Excise Tax", ylab = "Smoking Total")
abline(lm(smoking_total ~ excise_tax, data = smoking_data[smoking_data$period == "Early", ]), col = "blue")
abline(lm(smoking_total ~ excise_tax, data = smoking_data[smoking_data$period == "Late", ]), col = "red")
legend("topright", legend = c("Early (≤2010)", "Late (>2010)"), col = c("blue", "red"), pch = 16)
acf(resid(model), main = "ACF of Residuals")
install.packages("lmtest")
library(lmtest)
bptest(model)
model <- lm(l_smoking_total ~ l_excise_tax, data = smoking_data)
plot(model, which = 1)  # Residuals vs Fitted
bptest(model)
summary(model)
acf(resid(model), main = "ACF of Residuals")
